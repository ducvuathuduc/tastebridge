# TasteBridge frontend environment (copy to .env.local, which is git-ignored)
# Values come from your Base44 app. Never commit real values.

# Base44 app id
VITE_BASE44_APP_ID=your-base44-app-id

# Base URL of your Base44 app, e.g. https://your-app.base44.app
VITE_BASE44_APP_BASE_URL=

# Optional: pin a functions version
VITE_BASE44_FUNCTIONS_VERSION=

# Backend secrets are NOT set here. Set them in the Base44 dashboard / CLI:
#   QLOO_API_KEY   Qloo Taste AI key, read server-side by analyzeMarketEntry
