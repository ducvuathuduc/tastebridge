# TasteBridge web app (copy to .env.local, which is git-ignored)
# Base URL of the TasteBridge Worker API. Defaults to the production Worker when unset,
# and to http://localhost:8787 when the app runs on localhost.
VITE_API_BASE=https://tastebridge-api.huynhthanh.workers.dev

# Backend secrets are NOT set here. Set them on the Worker (see worker/README.md):
#   npx wrangler secret put QLOO_API_KEY
#   npx wrangler secret put GROQ_API_KEY     # or GEMINI_API_KEY / OPENAI_API_KEY
# For `wrangler dev`, put them in worker/.dev.vars (git-ignored).
